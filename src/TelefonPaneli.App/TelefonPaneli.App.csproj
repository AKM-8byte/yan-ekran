<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>$(WinTfm)</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>TelefonPaneli</AssemblyName>
    <RootNamespace>TelefonPaneli.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <PresentMonExe>$(MSBuildThisFileDirectory)..\..\tools\presentmon\PresentMon.exe</PresentMonExe>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\TelefonPaneli.Core\TelefonPaneli.Core.csproj" />
    <ProjectReference Include="..\TelefonPaneli.Windows\TelefonPaneli.Windows.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Update="wwwroot/**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="TelefonPaneli.App.Tests" />
  </ItemGroup>
  <ItemGroup Condition="Exists('$(PresentMonExe)')">
    <None Include="$(PresentMonExe)" Link="tools\presentmon\PresentMon.exe" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="QRCoder" Version="1.8.1" />
  </ItemGroup>
  <Target Name="WarnPresentMon" BeforeTargets="Build" Condition="!Exists('$(PresentMonExe)')">
    <Warning Text="tools/presentmon/PresentMon.exe yok: FPS kutucuklari bos kalacak (bkz. tools/presentmon/README.md)" />
  </Target>
</Project>
